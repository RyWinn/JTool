@page "/VocabMatch"

@inject ISnackbar Snackbar

@if (Loading)
{
    <Loading />
}
else
{
    <h1 class="text-center">Vocab Match</h1>

    <h3>Categories</h3>

    <ul style="max-height:200px; overflow-y:scroll;">
        @foreach (var category in Categories)
        {
            <MudSwitch Value="category.Visible" ValueChanged="() => ToggleVisibility(category)" T="bool" Color="Color.Primary"
                       Label="@category.CategoryName" Size="Size.Large" />
        }
    </ul>

    <MudCard>
        <MudCardContent>
            <div class="row align-items-center mb-2">
                <div class="col-4">
                    <label style="width:100%">@RandomEnglishWord.EnglishWord</label>
                </div>
                <div class="col-4">
                    <MudTextField @bind-Value="EnglishWord" Label="Romanji/Japanese" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" OnKeyDown="EnglishKeyPress" />
                </div>
                <div class="col-4">
                    <MudButton OnClick="SubmitEnglishWord" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true">Submit</MudButton>
                </div>
            </div>

            <div class="row align-items-center mb-2">
                <div class="col-4">
                    <label style="width:100%">@RandomRomanjiWord.RomanjiWord</label>
                </div>
                <div class="col-4">
                    <MudTextField @bind-Value="RomanjiWord" Label="English" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" OnKeyDown="RomanjiKeyPress" />
                </div>
                <div class="col-4">
                    <MudButton OnClick="SubmitRomanjiWord" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true">Submit</MudButton>
                </div>
            </div>

            <div class="row align-items-center mb-2">
                <div class="col-4">
                    <label style="width:100%">@RandomJapaneseWord.JapaneseWord</label>
                </div>
                <div class="col-4">
                    <MudTextField @bind-Value="JapaneseWord" Label="English" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" OnKeyDown="JapaneseKeyPress" />
                </div>
                <div class="col-4">
                    <MudButton OnClick="SubmitJapaneseWord" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true">Submit</MudButton>
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}